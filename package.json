{
  "name": "gmers",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Gmers: MVP Room Web (Gaple)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e",
    "build": "pnpm --filter @gmers/web build",
    "e2e": "pnpm --filter @gmers/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
