erDiagram
    GAME ||--o{ ROOM : dimainkan
    CONVERSATION ||--o{ ROOM : menyelenggarakan
    COMMUNITY ||--o{ ROOM : menyelenggarakan
    ROOM ||--o{ ROOM_PLAYER : kursi
    APP_USER ||--o{ ROOM_PLAYER : bermain
    ROOM ||--o{ GAME_MOVE : log
    ROOM ||--o| GAME_RESULT : berakhir
    GAME_RESULT ||--o{ RESULT_PLAYER : peringkat
    APP_USER ||--o{ RESULT_PLAYER : diperingkat
    ROOM ||--o| TICKET_BET : taruhan
    APP_USER ||--o{ TICKET_GIFT : memberi
    ROOM {
        uuid id PK
        text game_id FK
        uuid conversation_id FK
        uuid community_id FK
        text state
        bool ranked
        bool live
        bool random_match
    }
    ROOM_PLAYER {
        uuid room_id PK
        uuid user_id PK
        smallint seat
        text voice_mode
        bool connected
    }
    GAME_MOVE {
        uuid room_id PK
        int seq PK
        smallint seat
        jsonb payload
    }
    GAME_RESULT {
        uuid room_id PK
        text end_reason
        timestamptz ended_at
    }
    RESULT_PLAYER {
        uuid room_id PK
        uuid user_id PK
        smallint rank
        int trophy_delta
        int stars_earned
        bool counted_for_ticket
    }
    TICKET_BET {
        uuid id PK
        uuid room_id FK
        uuid user_a FK
        uuid user_b FK
        date day
        text state
        uuid winner_id
    }
    TICKET_GIFT {
        uuid id PK
        uuid giver_id FK
        uuid receiver_id FK
        timestamptz created_at
    }
