    FOLLOW {
        uuid follower_id PK
        uuid followee_id PK
    }
    CONTACT_SAVE {
        uuid saver_id PK
        uuid saved_id PK
    }
    FRIENDSHIP {
        uuid user_a PK
        uuid user_b PK
        text basis
        timestamptz since
    }
